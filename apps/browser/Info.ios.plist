<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated iOS Info.plist. Without it CoreBluetooth
	     reports the process Unauthorized and never prompts, so every page
	     would see getAvailability() answer false with nothing to explain
	     why. The macOS build gets the same key from ../Info.plist, linked
	     into the binary by build.rs. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>This app connects to nearby Bluetooth Low Energy devices that you choose from a list.</string>
</dict>
</plist>
